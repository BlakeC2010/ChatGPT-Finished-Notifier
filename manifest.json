{
  "manifest_version": 3,
  "name": "AI Chat Notifications",
  "version": "1.3.0",
  "description": "Get notified when supported AI chats finish responding.",
  "permissions": [
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*"
      ],
      "js": [
        "providers.js",
        "content-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
