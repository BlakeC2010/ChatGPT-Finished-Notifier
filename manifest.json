{
  "manifest_version": 3,
  "name": "AI Chat Notifications",
  "version": "1.3.1",
  "description": "Get notified when ChatGPT, Claude, or Gemini finishes responding.",
  "permissions": [
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "providers.js",
        "content-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
