{
  "manifest_version": 3,
  "name": "ChatGPT Finished Notifier",
  "version": "1.2.0",
  "description": "Notifies you when ChatGPT finishes responding with smart browser or system notifications.",
  "permissions": [
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
