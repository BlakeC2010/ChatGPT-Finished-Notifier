{
  "manifest_version": 3,
  "name": "ChatGPT Finished Notifier",
  "version": "1.0.0",
  "description": "Notifies you when ChatGPT finishes responding while you are on another tab or window.",
  "permissions": [
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
